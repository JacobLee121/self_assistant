# LLM provider: compass 或 deepseek。默认使用 compass。
LLM_PROVIDER=compass

# Compass API Key。也可通过 OPENAI_API_KEY 提供。
COMPASS_API_KEY=your-compass-api-key
COMPASS_MODEL=gemini-2.5-flash
COMPASS_API_BASE=https://compass.llm.shopee.io/compass-api/v1

# DeepSeek fallback：设置 LLM_PROVIDER=deepseek 时使用。
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Optional Langfuse trace export. Credentials must come from your Langfuse project.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://langfuse-poc.data-infra.shopee.io
LANGFUSE_FLUSH_AT_EXIT=true
LANGFUSE_FLUSH_EACH_TURN=false
LANGFUSE_TIMEOUT=30
LANGFUSE_MAX_INPUT_LEN=100000000
LANGFUSE_MAX_OUTPUT_LEN=400000000
